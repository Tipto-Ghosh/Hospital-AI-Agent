# ==================================================
# System Metadata
# ==================================================
HOSPITAL_NAME=City General Hospital
LOG_LEVEL=INFO

# ==================================================
# Database & Cache Infrastructure
# ==================================================
# Format:
# mysql+asyncmy://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+asyncmy://your_db_user:your_db_password@db:3306/hospital_ai

REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ==================================================
# LLM Configuration
# ==================================================
OLLAMA_BASE_URL=http://hospital-ollama:11434

GROQ_API_KEY=your_groq_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ==================================================
# Security, Sessions & Rate Limiting
# ==================================================
JWT_SECRET_KEY=your_random_64_character_hex_secret

JWT_EXPIRY_MINUTES=15
SESSION_TTL_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# ==================================================
# Langfuse Observability (Optional)
# ==================================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ==================================================
# LangSmith Tracing (Optional)
# ==================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Hospital-AI-Agent

# Optional (if required by your LangChain setup)
LANGCHAIN_API_KEY=your_langchain_api_key