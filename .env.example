# System Metadata
HOSPITAL_NAME = "City General Hospital"
LOG_LEVEL = INFO

# Database & Cache Infrastructure
# Format: mysql+asyncmy://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL = mysql+asyncmy://user:pass@hospital-db:3306/hospital_ai
REDIS_URL = redis://hospital-redis:6379/0
CELERY_BROKER_URL = redis://hospital-redis:6379/0

# LLM config
OLLAMA_BASE_URL = http://hospital-ollama:11434
GROQ_API_KEY = gsk_your_free_tier_key_here

# Security, Sessions & Rate Limiting
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY = your_super_secret_high_entropy_key
JWT_EXPIRY_MINUTES = 15
SESSION_TTL_MINUTES = 30
RATE_LIMIT_PER_MINUTE = 60

#  LLM Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY = pk-lf-... # put your langfuse public key
LANGFUSE_SECRET_KEY= sk-lf-... # put your langfuse secret key